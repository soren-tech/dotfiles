{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "mohsen-test"
  ],
  "provider": {
    "gapgpt": {
      "name": "GapGpt",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.gapgpt.app/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "gapgpt-qwen-3.6-thinking": {
          "name": "gapgpt-qwen-3.6-thinking"
        },
        "gapgpt-qwen-3.6": {
          "name": "gapgpt-qwen-3.6"
        },
        "claude-fable-5": {
          "name": "claude-fable-5"
        },
        "gpt-5.5": {
          "name": "gpt-5.5"
        },
        "gemini-3.5-flash": {
          "name": "gemini-3.5-flash"
        }
      }
    },
    "mohsen-test": {
      "name": "mohsenGPT",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.gapgpt.app/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        }
      }
    }
  }
}
/* GENERATED BY MATUGEN - DO NOT EDIT */
* {
    /* Base Transparency & Default Text */
    background-color: transparent;
    text-color:       #{{colors.on_surface.default.hex_stripped}}FF;

    /* Backgrounds (90% opacity) */
    bg:               #{{colors.surface.default.hex_stripped}}E6;
    bg-alt:           #{{colors.surface_container.default.hex_stripped}}E6;
    
    /* Text Colors */
    fg:               #{{colors.on_surface.default.hex_stripped}}FF;
    fg-dim:           #{{colors.on_surface_variant.default.hex_stripped}}FF;
    
    /* Accents (Material You Primary, Secondary, Tertiary) */
    primary:          #{{colors.primary.default.hex_stripped}}FF;
    secondary:        #{{colors.secondary.default.hex_stripped}}FF;
    tertiary:         #{{colors.tertiary.default.hex_stripped}}FF;
    error:            #{{colors.error.default.hex_stripped}}FF;

    /* Selection Highlights (20% opacity for subtle background effect) */
    selected-bg:        #{{colors.primary.default.hex_stripped}}33;
    selected-active-bg: #{{colors.secondary.default.hex_stripped}}33;
    selected-urgent-bg: #{{colors.error.default.hex_stripped}}33;
    
    /* Borders */
    border-color:     #{{colors.outline.default.hex_stripped}}FF;
}

# ==============================================================================
# KITTY CONFIGURATION TEMPLATE
# Theme: Catppuccin Mocha (Dark Modern)
# Context: Hyprland / Arch Linux
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FONTS
# ------------------------------------------------------------------------------
# I recommend installing 'ttf-jetbrains-mono-nerd' via pacman.
# It supports icons (Nerd Fonts) and ligatures (=>, !=, etc.).
# Primary English & Developer Icon font
font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
# Force Simplified Mandarin characters to use Noto Sans CJK SC
symbol_map U+4E00-U+9FFF Noto Sans CJK SC

# Force Persian/Arabic script characters to use Vazirmatn
symbol_map U+0600-U+06FF,U+0750-U+077F,U+08A0-U+08FF,U+FB50-U+FDFF,U+FE70-U+FEFF Vazirmatn
# Font size (in pts)
font_size 12.0

# Ligatures allow symbols like '=>' to render as a single arrow.
# Set to 'always' to enable, 'never' to disable.
disable_ligatures never

# ------------------------------------------------------------------------------
# 2. CURSOR & MOUSE
# ------------------------------------------------------------------------------
# Cursor shape: block, beam, or underline
cursor_shape block

# Stop the cursor from blinking after x seconds (0 = never stop)
cursor_stop_blinking_after 15.0

# Hide mouse cursor immediately when typing to avoid distraction
mouse_hide_wait 3.0

# URL handling: Style and behavior when hovering over links
url_color #89b4fa
url_style curly
open_url_with default

# ------------------------------------------------------------------------------
# 3. WINDOW LAYOUT & AESTHETICS
# ------------------------------------------------------------------------------
# 1.0 is opaque, 0.0 is invisible. 
# 0.85 is a sweet spot for Hyprland blur effects.
background_opacity 0.85

# Padding around the text area. 
# This adds a nice "breathing room" inside the terminal window.
window_padding_width 10

# Remember window size? (Not strictly necessary in a tiling WM, but good to have)
remember_window_size  yes
initial_window_width  640
initial_window_height 400

# Window border width (if not overridden by Hyprland)
window_border_width 0.5pt

# ------------------------------------------------------------------------------
# 4. TAB BAR
# ------------------------------------------------------------------------------
# Position of the tab bar
tab_bar_edge top

# Style: fade, slant, separator, powerline, custom, hidden
tab_bar_style powerline

# Powerline specific style: angled, slanted, round
tab_powerline_style slanted

# Tab title template (shows the active process, e.g., "nvim")
tab_title_template "{index}: {title}"

# ------------------------------------------------------------------------------
# 5. PERFORMANCE
# ------------------------------------------------------------------------------
# Delay (in ms) between screen updates. Lower = smoother but higher CPU.
# ~10ms is roughly 100fps.
repaint_delay 10

# Input latency optimization. 
# 3 is good for low latency without flickering.
input_delay 3

# Sync to monitor refresh rate to prevent tearing.
sync_to_monitor yes

# ------------------------------------------------------------------------------
# 6. BELL
# ------------------------------------------------------------------------------
# Disable the annoying audio bell
enable_audio_bell no

# Visual bell: flash the screen? (no is usually preferred)
visual_bell_duration 0.0

# ------------------------------------------------------------------------------
# 7. COLOR SCHEME (Catppuccin Mocha)
# ------------------------------------------------------------------------------
# The foreground (text) and background colors
foreground              #CDD6F4
background              #1E1E2E
selection_foreground    #1E1E2E
selection_background    #F5E0DC

# Cursor colors
cursor                  #F5E0DC
cursor_text_color       #1E1E2E

# URL underline color when hovering with mouse
url_color               #F5E0DC

# Kitty window border colors
active_border_color     #B4BEFE
inactive_border_color   #6C7086
bell_border_color       #F9E2AF

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Tab bar colors
active_tab_foreground   #11111B
active_tab_background   #CBA6F7
inactive_tab_foreground #CDD6F4
inactive_tab_background #181825
tab_bar_background      #11111B

# Colors for marks (marked text in the terminal)
mark1_foreground #1E1E2E
mark1_background #B4BEFE
mark2_foreground #1E1E2E
mark2_background #CBA6F7
mark3_foreground #1E1E2E
mark3_background #74C7EC

# The 16 terminal colors

# black
color0 #45475A
color8 #585B70

# red
color1 #F38BA8
color9 #F38BA8

# green
color2  #A6E3A1
color10 #A6E3A1

# yellow
color3  #F9E2AF
color11 #F9E2AF

# blue
color4  #89B4FA
color12 #89B4FA

# magenta
color5  #F5C2E7
color13 #F5C2E7

# cyan
color6  #94E2D5
color14 #94E2D5

# white
color7  #BAC2DE
color15 #A6ADC8

# ------------------------------------------------------------------------------
# 8. KEY BINDINGS
# ------------------------------------------------------------------------------
# Clipboard
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard

# Tab management
map ctrl+shift+t new_tab
map ctrl+shift+w close_tab
map ctrl+shift+right next_tab
map ctrl+shift+left previous_tab

# Font size
map ctrl+shift+equal change_font_size all +2.0
map ctrl+shift+plus change_font_size all +2.0
map ctrl+shift+minus change_font_size all -2.0
map ctrl+shift+backspace change_font_size all 0

# Window management (Kitty splits)
# New window (split)
map ctrl+shift+enter new_window
# Close window
map ctrl+shift+q close_window

# ------------------------------------------------------------------------------
# 9. SHELL INTEGRATION
# ------------------------------------------------------------------------------
# identifying the shell allows kitty to use specific features
shell_integration enabled

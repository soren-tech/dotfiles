@import "/home/ms/.config/rofi/colors.rasi"

* { font: "JetBrains Mono 12"; }

window {
    transparency:     true;
    location:         center;
    anchor:           center;
    width:            460px;
    border:           1px;
    border-color:     @border-color;
    border-radius:    20px;
    background-color: @bg;
    padding:          20px;
}

mainbox { children: [ inputbar, listview ]; spacing: 16px; }

inputbar {
    orientation:      horizontal;
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          8px 14px;
    background-color: @bg-alt;
    border-radius:    12px;
}
prompt { text-color: @primary; }
entry  { text-color: @fg; }

listview {
    lines:      8;
    columns:    1;
    spacing:    6px;
    cycle:      true;
    scrollbar:  false;
}

element {
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
    spacing:          14px;
    padding:          8px 12px;
    border:           2px;
    border-color:     transparent;
    border-radius:    12px;
}
element selected {
    border-color:     @primary;
    background-color: @selected-bg;
}

element-icon { size: 30px; border-radius: 8px; }   /* the color chip */
element-text { text-color: @fg; vertical-align: 0.5; }

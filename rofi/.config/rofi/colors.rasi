/* GENERATED BY MATUGEN - DO NOT EDIT */
* {
    /* Base Transparency & Default Text */
    background-color: transparent;
    text-color:       #e6e1e9FF;

    /* Backgrounds (90% opacity) */
    bg:               #141318E6;
    bg-alt:           #201f24E6;
    
    /* Text Colors */
    fg:               #e6e1e9FF;
    fg-dim:           #c9c4d0FF;
    
    /* Accents (Material You Primary, Secondary, Tertiary) */
    primary:          #cabeffFF;
    secondary:        #cac3dcFF;
    tertiary:         #edb8ccFF;
    error:            #ffb4abFF;

    /* Selection Highlights (20% opacity for subtle background effect) */
    selected-bg:        #cabeff33;
    selected-active-bg: #cac3dc33;
    selected-urgent-bg: #ffb4ab33;
    
    /* Borders */
    border-color:     #938f99FF;
}
